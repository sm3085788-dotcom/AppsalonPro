# Ejemplo de configuración de variables de entorno
# Copia este archivo en cada app y renómbralo a .env (móviles) o .env.local (web)

# === SUPABASE CREDENTIALS ===
# Obtén estos valores desde: https://app.supabase.com/project/YOUR_PROJECT/settings/api

# Para apps móviles (salon y clientes):
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Para app web (web-catalogo):
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
