# Copia a .env.local (no subir a git).
# En Vercel: Settings → Environment Variables (misma lista). Guía: ../../docs/VERCEL_WEB_SETUP.md
NEXT_PUBLIC_CONTACT_EMAIL=contacto@tudominio.com

# Supabase (OBLIGATORIO — mismo proyecto que apps Salón y Clientes)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Solo server (reservas, webhook Stripe). NUNCA exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Stripe (opcional; sin llaves el checkout corre en modo demo)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Moneda del checkout (Guatemala)
NEXT_PUBLIC_STRIPE_CURRENCY=gtq

# Google Maps Places (opcional; sin llave el autocompletado cae a entrada manual)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...

# Delivery ultima milla (opcional; sin llaves usa proveedor mock)
DELIVERY_PROVIDER=mock
DELIVERY_API_KEY=
