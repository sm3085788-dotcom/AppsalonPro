# Copia a .env.local (no subir a git).
NEXT_PUBLIC_CONTACT_EMAIL=contacto@tudominio.com

# Supabase (OBLIGATORIO)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# QPayPro / pagos (opcional; sin credenciales = modo demo)
PAYMENT_MODE=redirect
PAYMENT_PROVIDER=qpaypro
QPAYPRO_MERCHANT_ID=
QPAYPRO_API_KEY=
QPAYPRO_API_SECRET=
QPAYPRO_CHECKOUT_BASE_URL=
QPAYPRO_TOKENIZE_URL=
QPAYPRO_WEBHOOK_SECRET=
QPAYPRO_ENV=sandbox
NEXT_PUBLIC_PAYMENT_CURRENCY=gtq
WEB_PRODUCT_SHIPPING_FEE_GTQ=0
NEXT_PUBLIC_SITE_URL=https://tu-dominio.vercel.app

# Google Maps Places (opcional; sin esto la home muestra testimonios locales)
# Cuando tengas perfil en Google Business, agrega el Place ID para reseñas reales.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=

# Delivery ultima milla (opcional)
DELIVERY_PROVIDER=mock
DELIVERY_API_KEY=
