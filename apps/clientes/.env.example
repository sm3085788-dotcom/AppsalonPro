# Copiar a .env (no versionar): cp .env.example .env

# Supabase — Settings → API (Project URL y anon public key)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.reemplazar

# Opcional: URL de política de privacidad en la tienda
# EXPO_PUBLIC_PRIVACY_URL=https://tu-dominio.com/privacidad

# Catálogo web (Servicio al cliente → App web). Debe ser HTTPS público, no localhost ni IP local.
# EXPO_PUBLIC_WEB_CATALOG_URL=https://appsalon-pro-web-catalogo.vercel.app

# Stripe (domicilio + tarjeta en GTQ). Modo test: pk_test_…
# La moneda (gtq) se configura en Supabase: STRIPE_CURRENCY=gtq
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
